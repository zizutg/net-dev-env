FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash \
      iproute2 \
      iputils-ping \
      tcpdump \
      net-tools \
      curl \
      wget \
      nano \
      vim && \
    rm -rf /var/lib/apt/lists/*

CMD ["tail", "-f", "/dev/null"]
